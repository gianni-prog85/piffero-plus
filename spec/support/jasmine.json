{
  "reporters": [
    {
      "name": "jasmine-spec-reporter#SpecReporter",
      "options": {
        "displayStacktrace": "all"
      }
    }
  ],
  "spec_dir": "spec",
  "spec_files": [
    "**/*[sS]pec.ts"
  ],
  "jsLoader": "require",
  "env": {
    "forbidDuplicateNames": false
  },
  "helpers": [
  ] 
}
