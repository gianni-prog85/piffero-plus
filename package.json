{
  "name": "piffero-plus",
  "version": "1.0.0",
  "description": "The ultimate streaming JSONPath parser for Node.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "test": "jasmine-ts",
    "nyc:report": "nyc report",
    "coverage": "nyc npm run test",
    "coveralls": "nyc report --reporter=text-lcov | coveralls",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "tslint -p tsconfig.json",
    "prepare": "npm run build ",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "dev": "node --inspect=5858 -r ts-node/register dev/index.ts",
    "benchmark": "npm run build && cd benchmarking && node index.js",
    "benchmark:compare": "npm run build && node benchmarking/compare-parsers.js",
    "benchmark:bfj": "npm run build && node benchmarking/compare-bfj.js",
    "benchmark:streaming": "npm run build && node benchmarking/compare-streaming.js",
    "benchmark:200mb": "npm run build && node benchmarking/compare-200mb.js",
    "benchmark:filters": "npm run build && node benchmarking/bench-conditioneval.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gianni-prog85/piffero-plus.git"
  },
  "keywords": [
    "json",
    "sax",
    "jsonpath",
    "rfc9535",
    "parser",
    "stream",
    "progressive",
    "event",
    "emitter",
    "async",
    "piffero",
    "piffero-plus"
  ],
  "author": "Giovanni Fiorentino",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gianni-prog85/piffero-plus/issues"
  },
  "homepage": "https://github.com/gianni-prog85/piffero-plus#readme",
  "devDependencies": {
    "@sapientpro/json-stream": "^3.0.0",
    "@streamparser/json": "^0.0.26",
    "@types/jasmine": "^3.10.2",
    "@types/node": "^17.0.0",
    "base64-js": "^1.5.1",
    "benchmark": "^2.1.4",
    "bfj": "^9.1.4",
    "coveralls": "^3.1.1",
    "errors": "^0.3.0",
    "eslint": "^8.5.0",
    "express": "^4.17.2",
    "ieee754": "^1.2.1",
    "istanbul": "^0.4.5",
    "jasmine": "^3.10.0",
    "jasmine-spec-reporter": "^7.0.0",
    "jasmine-ts": "^0.4.0",
    "json-web-streams": "^1.2.0",
    "jsonpath-plus": "^11.3.0",
    "nodemon": "^2.0.15",
    "nyc": "^15.1.0",
    "prettier": "^2.5.1",
    "stream-json": "^3.9.0",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.4.0",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^4.5.4"
  }
}
